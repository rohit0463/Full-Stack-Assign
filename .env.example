# Key pool: comma-separated list of at least 2 API keys (key_1, key_2, ...)
LLM_API_KEYS=your-first-api-key-here,your-second-api-key-here

# SQLite Database URL (mounted volume in docker)
DATABASE_URL=sqlite:////data/app.db

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,*

# Enable failover test hook via X-Simulate-Failure header (required: true)
ENABLE_FAILURE_SIMULATION=true

# Model name for LiteLLM (e.g. gemini/gemini-2.0-flash, groq/llama-3.3-70b-versatile, etc.)
LLM_MODEL=gemini/gemini-2.0-flash

# Frontend API target URL (used during frontend build)
VITE_API_URL=http://localhost:8000
